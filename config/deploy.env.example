# Web deploy target — copy to config/deploy.env and fill in.
#
# config/deploy.env is gitignored on purpose: this repository is public, so the
# server behind ce.dietry.de / cloud.dietry.de must never be committed. The
# public hostname itself is derived by the scripts from edition + environment.
#
# Every value can also come from the environment instead, as
# DIETRY_DEPLOY_HOST / _USER / _PORT / _STAGE / _ROOT — useful in CI.

SSH_HOST=your-server.example.com
SSH_USER=deployuser
SSH_PORT=22

# Where the tarball is uploaded to before being unpacked.
REMOTE_STAGE=/home/deployuser

# Parent of the per-domain document roots; the scripts append <domain>/.
REMOTE_ROOT=/home/deployuser/public_html
